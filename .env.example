# Copy to .env and fill in.  docker compose reads this file automatically.

# ---- required -------------------------------------------------------------
# Signs the session cookie. Changing it logs everyone out.
#   openssl rand -base64 32
SESSION_SECRET=

# ---- database -------------------------------------------------------------
POSTGRES_USER=tonechaser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tonechaser

# ---- Google sign-in (optional) -------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> Web application
# Authorised redirect URI must be exactly:
#   http://127.0.0.1:8000/auth/google/callback
# (or https://your-domain/auth/google/callback in production)
# Leave both blank and the app runs with email/password accounts only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL. Required behind a proxy or a real domain, so the callback
# URL sent to Google matches what you registered. Leave blank for localhost.
BASE_URL=

# ---- serving --------------------------------------------------------------
PORT=8000
# Set to 1 when serving over HTTPS, so the session cookie is marked Secure.
COOKIE_SECURE=0
# Set to 0 to close signups once your own account exists.
ALLOW_REGISTRATION=1
# Raise if Demucs gets OOM-killed on long tracks.
APP_MEMORY_LIMIT=8g
